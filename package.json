{
  "name": "dad",
  "version": "1.0.4-dev",
  "desktopName": "dad.desktop",
  "description": "Developer Automation Desktop — atompunk dev environment",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "postinstall": "electron-builder install-app-deps",
    "release": "bash build/release.sh"
  },
  "keywords": [],
  "author": {
    "name": "rulu",
    "email": "rulu@nykredit.dk"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "typescript": "~5.0.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/history": "^0.19.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/uuid": "^10.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.11",
    "node-pty": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^10.0.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "dk.rulu.dad",
    "productName": "Developer Automation Desktop",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**",
      "**/*.node"
    ],
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "icon": "./assets/dad.png",
      "executableName": "dad",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "tmux"
      ],
      "packageName": "dad",
      "afterInstall": "./build/postinst.sh"
    },
    "publish": {
      "provider": "github",
      "owner": "runagar",
      "repo": "developer-automation-desktop"
    }
  }
}
